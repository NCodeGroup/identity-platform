# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
.vs/
.idea/

# Claude Code: personal settings and worktrees
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Leftovers from `copier update --conflict rej`
*.rej

# The plan in progress: a local working file, never committed
PLAN.md

# Secrets
.env
.env.*
!.env.example
/secrets/

# Kept from this repository's own .gitignore when it adopted the project template
# OpenTofu working directories and state — state lives in the remote backend, never in Git
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log

# Plan/apply output can contain rendered secrets — never commit it
plan.txt
apply.txt

# Local-only overrides (for example the first-run local backend in live/bootstrap)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Operator-specific or secret variable files
*.auto.tfvars
*.auto.tfvars.json
secrets.tfvars

# Components are libraries: their consumers own the provider lock file
modules/**/.terraform.lock.hcl
